{
  "name": "@snowlocked/dsh-k8s-console",
  "version": "0.4.0",
  "private": true,
  "description": "DSH K8s 控制台插件：管理 kubeconfig，点开即建会话 Tab（可重复开多个），每个会话含「kubectl 命令控制台」与「AI 对话」两个子页；AI 复用 DSH 自身模型配置。",
  "license": "MIT",
  "type": "module",
  "main": "./dist/dsh-k8s-console.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "kubernetes",
    "k8s",
    "kubectl",
    "kubeconfig",
    "ai"
  ],
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "esbuild": "^0.25.0",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.0"
  }
}
